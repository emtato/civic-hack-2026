  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/media": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render Proviso-Story-v2 out/proviso-story-v2.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --concurrency=3 --is-production=false",
    "render:opening": "remotion render Proviso-Story-v2 out/proviso-opening-v2.mp4 --frames=0-419 --codec=h264 --crf=20 --concurrency=3 --is-production=false",
    "music": "python3 scripts/make-music.py",
    "capture:api": "../backend/.venv/bin/python scripts/film-api.py",
    "render:v1": "remotion render Proviso-Draft out/proviso-draft-v1.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --concurrency=2 --is-production=false",
    "render:clean": "remotion render Proviso-Story-v2 out/proviso-story-v2-clean.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --concurrency=3 --is-production=false --props=./clean-props.json",
    "capture:api:v1": "node scripts/fixture-server.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
